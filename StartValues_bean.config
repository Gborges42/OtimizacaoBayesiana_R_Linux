!=================================================

! Diretorio do experimnto
dirExperiment = .//Baseline//Bean

! Diretorio do DSSAT
dssatFile = .//bin//dscsm047

! Arquivo de cultivares
cultivarFile = .//Baseline//Bean//BNGRO047.CUL

!=================================================

! Diretorio de saida (saida de resultados finais)
outputDir = .//output

!=================================================

! Semente de geracao dos dados (motivos de reproducao)
! Coloque '0' para semente aleatoria
seed = 0

!=================================================

! Identificador do cultivar
cultivar = IB0096

! Identificador do modelo
model = CRGRO047

! Coeficientes de analise
! Variaveis problematicas = THRSH
! CSDL, PPSEN, EM-FL, FL-SH, FL-SD, SD-PM, FL-LF, LFMAX, SLAVR, SIZLF,  XFRT, WTPSD, SFDUR, SDPDV, PODUR, SDPRO, SDLIP
coefficients = EM-FL, FL-SH, FL-SD, SD-PM, FL-LF, LFMAX, SLAVR, SIZLF

! Limite dos coeficientes
! Cada coeficiente deve ter um limite inferior e superios, atribuidos por nome
limites = EM-FL:15;55, FL-SH:2;10, FL-SD:5;20, SD-PM:15;40, FL-LF:5;30, LFMAX:0.6;1.2, SLAVR:260;335, SIZLF:128;165

! Variaveis de calibracao
! ADAP, PD1P, PDFP, MDAP, HWAM, PWAM, H#AM, HWUM, H#UM, CWAM, LAIX, THAM, CWAA
calibration = ADAP, PD1P, PDFP, MDAP, LAIX

! Quanidade de pontos iniciais
initPoints = 10

! Numero de Iteracoes
iters.n = 5

! Tamanho do elemento k
iters.k = 1

! Configuração para o programa rodar em paralelo
! Escreva TRUE caso queira que o programa rode em paralelo
! Escreva FALSE caso não.
paralelo = TRUE

! Quantos cores serão utilizados em paralelo?
! LEMBRE-SE: o elemento k deve ser múltilplo desse número, não pode ser 1.
cores = 2

! Tipo de funcao de aquisicao
acq = ucb

! Método de cálculo do erro
! rmse, mape
metodo_score = rmse
!=================================================
